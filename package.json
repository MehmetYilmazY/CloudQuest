{
  "name": "cloudquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud Engineering RPG - SSOT build pipeline + shared verification core",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "build:check": "node --experimental-strip-types scripts/build.ts --check",
    "validate": "node --experimental-strip-types scripts/build.ts --validate-only",
    "test": "node --experimental-strip-types --test shared/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ci": "npm run validate && npm test && npm run build:check && npm run check:links",
    "content": "node --experimental-strip-types scripts/content.ts",
    "check:links": "node --experimental-strip-types scripts/check-links.ts",
    "deploy": "npm run build && npx supabase functions deploy game"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "marked": "^18.0.10",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  }
}
